# Roboflow hosted object-detection model.
# Get your API key from: Roboflow app -> Workspace Settings -> API Keys (use the Private key, not Publishable)
# Get your model ID from: your project's Versions page -> "Get cURL command" (format is project-id/version-number)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=

# Optional tuning (defaults shown)
ROBOFLOW_CONFIDENCE=0.40
ROBOFLOW_OVERLAP=0.50

# Optional: restrict to specific class names from your Roboflow project
# (comma-separated). Leave blank to accept any class the model returns.
ROBOFLOW_ACCEPTED_CLASSES=
